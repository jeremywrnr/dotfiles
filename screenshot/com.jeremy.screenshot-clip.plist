<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by install.sh — edit this template, not the copy in
     ~/Library/LaunchAgents, which records the checkout path at install time. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jeremy.screenshot-clip</string>

    <key>ProgramArguments</key>
    <array>
        <string>__DOTFILES__/screenshot/screenshot-clip.sh</string>
    </array>

    <!-- Fires on every change in the screenshot directory. launchd will not
         expand ~ here, so install.sh stamps in the home directory the same way
         it stamps in the checkout path. -->
    <key>WatchPaths</key>
    <array>
        <string>__HOME__/Pictures/Screenshots</string>
    </array>

    <!-- launchd refuses to restart a job more often than every
         ThrottleInterval seconds, and the default of 10 would leave the second
         of two quick captures sitting unread for most of that. -->
    <key>ThrottleInterval</key>
    <integer>1</integer>

    <key>StandardErrorPath</key>
    <string>/tmp/screenshot-clip.err</string>
</dict>
</plist>
