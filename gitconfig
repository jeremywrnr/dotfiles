[user]
    name  = Jeremy Warner
    email = jeremywrnr@gmail.com
[include]
    # per-machine settings that cannot be shared, e.g.
    #   [credential] helper = osxkeychain   (macOS)
    #   [credential] helper = cache         (Linux)
    path = ~/.gitconfig.local
[push]
    default = current
[pull]
    rebase = true
[rebase]
    autoStash = true
[fetch]
    prune = true
[init]
    defaultBranch = main
[alias]
    s = status
    a = add -A
    c = commit -am
    d = diff
    t = tag -n9
    wc = log --numstat --oneline
    lp = log -p
    lg = log --oneline --decorate --color --graph
    lgg = log --pretty=format:'%C(yellow)%h %C(cyan)%ad%Cgreen%d %Creset%s' --date=short
    la = log --graph --decorate --pretty=format:'%C(yellow)%h %Cred%cr %Cblue(%an)%C(white)%d%Creset %s' --abbrev-commit --all
    br = branch
    co = checkout --ignore-other-worktrees
    ps = push
    pl = pull
    up = pull
    last = log -p --max-count=1 --word-diff
    alias = config --get-regexp alias
    # was util/git-add-commit-push; pushes the current branch, not a hardcoded one.
    # `acp` opens the editor; `acp fix the thing` (quoted or not) commits with that message.
    # With nothing staged it skips the commit and still pushes, so unpushed commits go out.
    acp = add-commit-push
    add-commit-push = "!f() { git add -A && git status && if git diff --cached --quiet; then :; elif [ $# -gt 0 ]; then git commit -m \"$*\"; else git commit -v; fi && git push origin HEAD; }; f"
    # was util/git-historian: interactive rebase back to the root commit
    historian = !git rebase -i $(git rev-list --max-parents=0 HEAD)
    # Fold the working tree into the last commit and re-push it, to kick CI.
    # --force-with-lease refuses if someone else pushed to the branch meanwhile.
    retest = !git commit --amend --no-edit && git push --force-with-lease
    rt = retest
    su = set-upstream
    set-upstream = !git branch --set-upstream-to=origin/`git symbolic-ref --short HEAD`
    ro = restore-origin
    restore-origin = restore --source origin/main
    # Discards local commits and changes: the branch becomes exactly its upstream.
    rho = reset-hard-origin
    reset-hard-origin = !git fetch && git reset --hard '@{upstream}'
    sb = squash-branch
    squash-branch = !git reset --soft $(git merge-base main HEAD) && git commit -m squash-onto-main
    cob = clean-old-branches
    clear-old-branches = !git clean-old-branches
    clean-old-branches = !git branch --merged main | grep -vE '^[*]|main|master' | xargs -n 1 git branch -d
    gwc = diff --stat main...HEAD
[core]
    excludesfile = ~/.gitignore_global
    editor = vim
    autocrlf = input
[diff]
    algorithm = minimal
    renames = true
    colorMoved = default
[merge]
    conflictstyle = zdiff3
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
