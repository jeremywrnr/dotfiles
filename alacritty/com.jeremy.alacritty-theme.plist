<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by install.sh — edit this template, not the copy in
     ~/Library/LaunchAgents, which records the checkout path at install time. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jeremy.alacritty-theme</string>

    <key>ProgramArguments</key>
    <array>
        <string>__DOTFILES__/alacritty/theme-sync.sh</string>
    </array>

    <!-- Fires on load, on the interval, and again on wake from sleep. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardErrorPath</key>
    <string>/tmp/alacritty-theme.err</string>
</dict>
</plist>
