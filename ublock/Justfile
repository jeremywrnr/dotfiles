# Filters browser: a chrome-dev instance with its own profile and port, so it
# never collides with the default one on :9222. uBO Lite sits beside its
# profile (see scripts/get-ubol.sh for why it isn't in the repo).
export CHROME_DEV_HOME := env("HOME") / ".local/share/chrome-dev-filters"
export CHROME_DEV_PORT := "9223"
export UBOL_DIR := CHROME_DEV_HOME / "ubol"

# List recipes
default:
    @just --list

# Download (or upgrade) uBO Lite
ubol:
    ./scripts/get-ubol.sh

# Launch the filters browser with uBO Lite (no-op if it is already running)
browser url="https://www.youtube.com" *flags="":
    @[ -f "$UBOL_DIR/manifest.json" ] || ./scripts/get-ubol.sh
    @[ -e "$CHROME_DEV_HOME/chrome" ] || ln -s "{{env("HOME")}}/.local/share/chrome-dev/chrome" "$CHROME_DEV_HOME/chrome"
    chrome-dev {{flags}} --ext "$UBOL_DIR" "{{url}}"

# Relaunch the filters browser (picks up an upgraded uBO Lite)
restart url="https://www.youtube.com":
    just browser "{{url}}" --restart

# Check filters.txt: syntax via uBO Lite's own parser, plus test metadata
lint:
    node scripts/lint.mjs filters.txt

# Tests for the tooling (list parser, every lint rule); no browser needed
unit:
    node --test test/lint.test.mjs

# End-to-end: load filters.txt into uBO Lite in the filters browser, check every filter hides its target
test *args="":
    node --test --test-concurrency=1 --test-timeout=120000 {{args}} test/filters.test.mjs

# `just test`, plus before/after screenshots of every test page in <dir>/index.html
report dir="/tmp/ublock-filters-report":
    rm -rf "{{dir}}"
    REPORT_DIR="{{dir}}" just test
    @echo "report: {{dir}}/index.html"

# Screenshot a tab with and without a candidate selector: just diff <url-substring> '<selector>' [outdir]
diff match selector outdir="/tmp/ublock-filters-diff":
    ./scripts/filter-diff.sh "{{match}}" "{{selector}}" "{{outdir}}"

# Work open filter requests (issues labeled ublock), one Claude session and worktree each: just inbox [number | --list]
inbox *args="":
    node scripts/inbox.mjs {{args}}

# File a filter request and start working it: just hide <url> "<what to hide>" ['<picker filter>']
hide $url $what $picker="":
    node scripts/inbox.mjs hide "$url" "$what" "$picker"
