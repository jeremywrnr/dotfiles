<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by install.sh — edit this template, not the copy in
     ~/Library/LaunchAgents, which records the checkout path at install time. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jeremy.tm-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>__DOTFILES__/bin/tm</string>
        <string>check</string>
    </array>

    <!-- Four hours: often enough that a broken backup surfaces the same day,
         rare enough that the notification still means something. `tm check`
         is silent unless something is actually wrong. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>14400</integer>

    <key>StandardErrorPath</key>
    <string>/tmp/tm-check.err</string>
</dict>
</plist>
